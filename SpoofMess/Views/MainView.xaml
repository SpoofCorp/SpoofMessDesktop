<UserControl x:Class="SpoofMess.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpoofMess.Views"
        xmlns:ve="clr-namespace:SpoofMess.ViewElements"
        xmlns:filevm="clr-namespace:SpoofMess.ViewModels.FileViewModels"
        xmlns:vm="clr-namespace:SpoofMess.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel, IsDesignTimeCreatable=False}">
    <Grid Background="{DynamicResource Third}" RowDefinitions="auto *" ColumnDefinitions="0.45* auto *">
        <ve:SideMenu Grid.RowSpan="2" Background="{DynamicResource Primary}" x:Name="SideMenu" IsOpen="{Binding SideMenuVisibility}" Panel.ZIndex="10" Grid.ColumnSpan="3">
            <StackPanel>
                <ve:FunctionButton Click="Menu_Item_Click" Text="{DynamicResource Profile}" Alignment="Stretch" Icon="👤" Command="{Binding ShowProfileCommand}"/>
                <ve:FunctionButton Click="Menu_Item_Click" Text="{DynamicResource NewGroup}" Alignment="Stretch" Icon="👥" Command="{Binding ShowCreateGroupCommand}"/>
                <ve:FunctionButton Click="Menu_Item_Click" Text="{DynamicResource Settings}" Alignment="Stretch" Icon="⚙️" Command="{Binding ShowSettingsCommand}"/>
            </StackPanel>
        </ve:SideMenu>
        <Grid Grid.RowSpan="2" RowDefinitions="auto *">
            <Border Height="50" Style="{StaticResource FunctionBlockBorderLeft}">
                <DockPanel>
                    <Button Focusable="False" Height="40" Width="40" Padding="0 0 0 5" VerticalAlignment="Center" DockPanel.Dock="Left" Content="≡" Style="{StaticResource MinimalCircleButton}" Click="Menu_Click"/>
                    <ve:InputTextBox Holder="{DynamicResource SearchHolder}" Text="{Binding ChatsViewModel.Query}" DockPanel.Dock="Right" Margin="0 5 5 5"/>
                </DockPanel>
            </Border>
            <ScrollViewer Style="{DynamicResource ChatListScrollViewer}" SnapsToDevicePixels="True" Grid.Row="1">
                <ListBox Style="{StaticResource ChatList}" Visibility="{Binding ChatsViewModel.ChatsVisibility}" ItemsSource="{Binding ChatsViewModel.Chats}" x:Name="ChatsList" SelectedItem="{Binding ChatsViewModel.SelectedChat}" MinWidth="100">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0 2.5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="7"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" Grid.RowSpan="2" Width="45" Height="45">
                                    <Border x:Name="Mask" 
                    BorderThickness="1" 
                    CornerRadius="50" 
                    Background="{DynamicResource Primary}"
                    BorderBrush="Transparent"/>
                                    <Image Source="{Binding Avatar.Path, TargetNullValue='pack://application:,,,/Assets/No_Cover.jpg', FallbackValue='pack://application:,,,/Assets/No_Cover.jpg'}" Stretch="Fill">
                                        <Image.OpacityMask>
                                            <VisualBrush Visual="{x:Reference Mask}"/>
                                        </Image.OpacityMask>
                                    </Image>
                                </Grid>
                                <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding Name}" Style="{DynamicResource BaseText}" FontSize="16" FontWeight="DemiBold"/>
                                <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" Text="{Binding LastMessage.PreviewText}" Style="{DynamicResource BaseText}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="50"/>
                                <TextBlock Grid.Column="3" Padding="0 0 5 0" Grid.Row="0" Text="{Binding LastMessage.SentAt, StringFormat={}{0:HH:mm}}" Style="{DynamicResource AdditionalText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" Background="{DynamicResource Second}" VerticalScrollBarVisibility="Auto" SnapsToDevicePixels="True" Visibility="{Binding ChatsViewModel.SearchResultsVisibility}" Grid.Row="1">
                <Grid RowDefinitions="auto auto">
                    <ListBox Style="{StaticResource NoScrollListBoxStyle}" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="{DynamicResource Second}" ItemsSource="{Binding ChatsViewModel.SearchResultsChats}" SelectedItem="{Binding ChatsViewModel.SelectedSearchableEntity}" MinWidth="100">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <Grid VerticalAlignment="Top" Grid.Column="0" Grid.RowSpan="2" Width="40" Height="40">
                                        <Border x:Name="Mask" 
                                            BorderThickness="1" 
                                            CornerRadius="40" 
                                            Background="White"
                                            BorderBrush="Gray"/>
                                        <Image Source="{Binding Avatar.Path, TargetNullValue='pack://application:,,,/Assets/No_Cover.jpg', FallbackValue='pack://application:,,,/Assets/No_Cover.jpg'}" Stretch="Fill">
                                            <Image.OpacityMask>
                                                <VisualBrush Visual="{x:Reference Mask}"/>
                                            </Image.OpacityMask>
                                        </Image>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Name}" Style="{DynamicResource BaseText}" FontWeight="DemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox Style="{StaticResource NoScrollListBoxStyle}" ScrollViewer.VerticalScrollBarVisibility="Disabled" Grid.Row="1" Background="{DynamicResource Second}" ItemsSource="{Binding ChatsViewModel.SearchResultsMessages}" SelectedItem="{Binding ChatsViewModel.SelectedSearchableMessage}" MinWidth="100">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="auto * auto" RowDefinitions="auto *">

                                    <Grid VerticalAlignment="Top" Grid.Column="0" Grid.RowSpan="2" Width="40" Height="40">
                                        <Border x:Name="Mask" 
                                            BorderThickness="1" 
                                            CornerRadius="40" 
                                            Background="White"
                                            BorderBrush="Gray"/>
                                        <Image Source="{Binding Chat.Avatar.Path, TargetNullValue='pack://application:,,,/Assets/No_Cover.jpg', FallbackValue='pack://application:,,,/Assets/No_Cover.jpg'}" Stretch="Fill">
                                            <Image.OpacityMask>
                                                <VisualBrush Visual="{x:Reference Mask}"/>
                                            </Image.OpacityMask>
                                        </Image>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Chat.Name}" FontSize="16" Style="{StaticResource BaseText}" FontWeight="DemiBold"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Text}" Style="{StaticResource BaseText}" FontSize="14" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="50"/>
                                    <TextBlock VerticalAlignment="Bottom" Grid.Column="2" Grid.Row="1" Text="{Binding SentAt, StringFormat={}{0:hh:MM}}" Style="{StaticResource AdditionalText}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ScrollViewer>
        </Grid>
        <GridSplitter Grid.Row="1" Focusable="False" Grid.Column="1" Background="Transparent" Panel.ZIndex="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="2"/>
        <Border Background="{DynamicResource Third}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
            <ContentPresenter Content="{Binding MessagesViewModel}"/>
        </Border>
        <Grid Visibility="{Binding ChatsViewModel.AdditionalViewModelVisibility}" Grid.RowSpan="2" Grid.ColumnSpan="3" Panel.ZIndex="10">
            <Rectangle Fill="{DynamicResource ShadowColor}" Tag="{Binding ChatsViewModel.AdditionalViewModel}" PreviewMouseLeftButtonDown="Rectangle_PreviewMouseLeftButtonDown">
                <Rectangle.Style>
                    <Style TargetType="{x:Type Rectangle}">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ChatsViewModel.AdditionalViewModelVisibility}" Value="Collapsed">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation                 
                                                 To="0"
                                                 Storyboard.TargetProperty="Opacity"
                                                 Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                 To="0.7"
                                                 Storyboard.TargetProperty="Opacity"
                                                 Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10" Visibility="{Binding ChatsViewModel.AdditionalViewModelVisibility}" Tag="{Binding ChatsViewModel.AdditionalViewModel, Mode=TwoWay}" Grid.RowSpan="2" Grid.ColumnSpan="3" MouseDown="Border_MouseDown" Background="Transparent">
                <Border Style="{DynamicResource CardBorder}" Margin="0"/>
                <Border MouseDown="ContentPresenter_MouseDown" Padding="5" Background="{DynamicResource Primary}" CornerRadius="10">
                    <ContentPresenter MouseDown="ContentPresenter_MouseDown" Content="{Binding ChatsViewModel.AdditionalViewModel}">
                        <ContentPresenter.Resources>
                            <DataTemplate DataType="{x:Type vm:ChatCardViewModel}">
                                <Grid Height="200" Width="300" RowDefinitions="auto auto * auto" ColumnDefinitions="auto *">
                                    <Ellipse Margin="5 0" HorizontalAlignment="Center" VerticalAlignment="Top" Grid.Column="0" Grid.RowSpan="4" Width="45" Height="45">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding Chat.Avatar.Path, TargetNullValue='pack://application:,,,/Assets/No_Cover.jpg', FallbackValue='pack://application:,,,/Assets/No_Cover.jpg'}" Stretch="Fill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Style="{StaticResource PrimaryText}" Text="{Binding Chat.Name}" Grid.Column="1"/>
                                    <TextBlock Style="{StaticResource PrimaryText}" Text="{Binding Chat.UniqueName}" Grid.Column="1" Grid.Row="1"/>
                                    <Button Content="Join" Command="{Binding JoinCommand}" Style="{StaticResource FunctionButton}" Grid.Column="1" Grid.Row="3"/>
                                </Grid>
                            </DataTemplate>
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                </Border>
            </Grid>
        </Grid>
        <Grid Visibility="{Binding AdditionalVisibility}" x:Name="AdditionalContainer" Grid.RowSpan="2" Grid.ColumnSpan="3" Panel.ZIndex="10">
            <Rectangle Fill="{DynamicResource ShadowColor}" Tag="{Binding AdditionalView}" PreviewMouseLeftButtonDown="Rectangle_PreviewMouseLeftButtonDown">
                <Rectangle.Style>
                    <Style TargetType="{x:Type Rectangle}">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AdditionalVisibility}" Value="Collapsed">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation                 
                                                 To="0"
                                                 Storyboard.TargetProperty="Opacity"
                                                 Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                 To="0.7"
                                                 Storyboard.TargetProperty="Opacity"
                                                 Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Tag="{Binding AdditionalView, Mode=TwoWay}" MouseDown="Border_MouseDown" Background="Transparent">
                <Border Style="{DynamicResource CardBorder}" Margin="0"/>
                <Border x:Name="Container" MouseDown="ContentPresenter_MouseDown" Padding="0" Background="{DynamicResource Primary}" CornerRadius="10">
                    <ContentPresenter MouseDown="ContentPresenter_MouseDown" Content="{Binding AdditionalView}">

                    </ContentPresenter>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
