<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key="ShadowColor" Color="#090A0B"/>
    <SolidColorBrush x:Key="Black" Color="#111214"/>

    <SolidColorBrush x:Key="DefaultTextColor" Color="#9EA4B0"/>
    <SolidColorBrush x:Key="ActiveTextColor" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="PrimaryBlack" Color="#161719"/>
    <SolidColorBrush x:Key="SecondBlack" Color="#1E1F22"/>
    
    <SolidColorBrush x:Key="SixWhite" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FiveWhite" Color="#E3E5E8"/>
    <SolidColorBrush x:Key="FourWhite" Color="#A6ADB9"/>
    <SolidColorBrush x:Key="ThirdWhite" Color="#202225"/>
    <SolidColorBrush x:Key="SecondWhite" Color="#2B2D31"/>
    <SolidColorBrush x:Key="PrimaryWhite" Color="#161719"/>

    <SolidColorBrush x:Key="PrimaryAccent" Color="#5865F2"/>
    <SolidColorBrush x:Key="SecondAccent" Color="#4752C4"/>
    <SolidColorBrush x:Key="ThirdAccent" Color="#38429B"/>

    <Color x:Key="ThirdWhiteColor">#202225</Color>
    <Color x:Key="SecondWhiteColor">#2B2D31</Color>
    <Color x:Key="PrimaryWhiteColor">#161719</Color>
    <Color x:Key="PrimaryAccentColor">#5865F2</Color>
    <Color x:Key="SecondAccentColor">#4752C4</Color>
    <Color x:Key="ThirdAccentColor">#38429B</Color>
</ResourceDictionary>