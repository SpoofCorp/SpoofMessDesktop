<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="ShadowColor" Color="#111111"/>
    <SolidColorBrush x:Key="Black" Color="#0F131A"/>

    <SolidColorBrush x:Key="ActiveTextColor" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="DefaultTextColor" Color="#94A3B8"/>

    <SolidColorBrush x:Key="PrimaryBlack" Color="#1E2430"/>
    <SolidColorBrush x:Key="SecondBlack" Color="#141822"/>

    <SolidColorBrush x:Key="Primary" Color="#283141"/>
    <SolidColorBrush x:Key="Second" Color="#1A202C"/>
    <SolidColorBrush x:Key="Third" Color="#333D52"/>
    <SolidColorBrush x:Key="Four" Color="#475569"/>
    <SolidColorBrush x:Key="Five" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Six" Color="#E2E8F0"/>

    <SolidColorBrush x:Key="PrimaryAccent" Color="#70B2FF"/>
    <SolidColorBrush x:Key="SecondAccent" Color="#4D9EFF"/>
    <SolidColorBrush x:Key="ThirdAccent" Color="#338BFF"/>

    <Color x:Key="ThirdWhiteColor">#333D52</Color>
    <Color x:Key="SecondWhiteColor">#1A202C</Color>
    <Color x:Key="PrimaryWhiteColor">#283141</Color>

    <Color x:Key="PrimaryAccentColor">#70B2FF</Color>
    <Color x:Key="SecondAccentColor">#4D9EFF</Color>
    <Color x:Key="ThirdAccentColor">#338BFF</Color>
</ResourceDictionary>