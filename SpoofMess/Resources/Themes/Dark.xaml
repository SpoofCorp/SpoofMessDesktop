<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key="ActiveTextColor" Color="#F0F6FC"/>
    <SolidColorBrush x:Key="DefaultTextColor" Color="#767F8D"/>
    
    <SolidColorBrush x:Key="PrimaryBlack" Color="#0A0D14"/>
    <SolidColorBrush x:Key="SecondBlack" Color="#0E1117"/>
    
    <SolidColorBrush x:Key="PrimaryWhite" Color="#1C212B"/>
    <SolidColorBrush x:Key="SecondWhite" Color="#0A0C10"/>
    <SolidColorBrush x:Key="ThirdWhite" Color="#161B22"/>
    <SolidColorBrush x:Key="FourWhite" Color="#21262D"/>
    <SolidColorBrush x:Key="FiveWhite" Color="#8B949E"/>
    <SolidColorBrush x:Key="SixWhite" Color="#FFFFFF"/>
    
    <SolidColorBrush x:Key="PrimaryAccent" Color="#2472E5"/>
    <SolidColorBrush x:Key="SecondAccent" Color="#1F6FEB"/>
    <SolidColorBrush x:Key="ThirdAccent" Color="#1250B4"/>
    
    <Color x:Key="PrimaryWhiteColor">#1C212B</Color>
    <Color x:Key="SecondWhiteColor">#0A0C10</Color>
    <Color x:Key="ThirdWhiteColor">#161B22</Color>

    <Color x:Key="PrimaryAccentColor">#2472E5</Color>
    <Color x:Key="SecondAccentColor">#1F6FEB</Color>
    <Color x:Key="ThirdAccentColor">#1250B4</Color>
</ResourceDictionary>