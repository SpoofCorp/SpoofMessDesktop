<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key="ShadowColor" Color="#050505"/>
    <SolidColorBrush x:Key="Black" Color="#000000"/>
    
    <SolidColorBrush x:Key="DefaultTextColor" Color="#8E9AA8"/>
    <SolidColorBrush x:Key="ActiveTextColor" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="PrimaryBlack" Color="#0A0F14"/>
    <SolidColorBrush x:Key="SecondBlack" Color="#111822"/>
    
    <SolidColorBrush x:Key="SixWhite" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FiveWhite" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="FourWhite" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ThirdWhite" Color="#16222F"/>
    <SolidColorBrush x:Key="SecondWhite" Color="#1F2E3E"/>
    <SolidColorBrush x:Key="PrimaryWhite" Color="#0D151F"/>
    
    <SolidColorBrush x:Key="PrimaryAccent" Color="#3B82F6"/>
    <SolidColorBrush x:Key="SecondAccent" Color="#2563EB"/>
    <SolidColorBrush x:Key="ThirdAccent" Color="#1D4ED8"/>

    <Color x:Key="ThirdWhiteColor">#16222F</Color>
    <Color x:Key="SecondWhiteColor">#1F2E3E</Color>
    <Color x:Key="PrimaryWhiteColor">#0D151F</Color>
    <Color x:Key="PrimaryAccentColor">#3B82F6</Color>
    <Color x:Key="SecondAccentColor">#2563EB</Color>
    <Color x:Key="ThirdAccentColor">#1D4ED8</Color>
</ResourceDictionary>