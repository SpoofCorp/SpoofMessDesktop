<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ShadowColor" Color="#070A0F"/>

    <SolidColorBrush x:Key="DefaultTextColor" Color="#C2B4C7"/>
    <SolidColorBrush x:Key="ActiveTextColor" Color="#FFF5F8"/>
    
    <SolidColorBrush x:Key="PrimaryBlack" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondBlack" Color="#FFF0F5"/>
    
    <SolidColorBrush x:Key="SixWhite" Color="#F472B6"/>
    <SolidColorBrush x:Key="FiveWhite" Color="#D6BCFA"/>
    <SolidColorBrush x:Key="FourWhite" Color="#FBCFE8"/>
    <SolidColorBrush x:Key="ThirdWhite" Color="#251E2B"/>
    <SolidColorBrush x:Key="SecondWhite" Color="#3D3045"/>
    <SolidColorBrush x:Key="PrimaryWhite" Color="#1C1621"/>

    <SolidColorBrush x:Key="PrimaryAccent" Color="#FBCFE8"/>
    <SolidColorBrush x:Key="SecondAccent" Color="#F472B6"/>
    <SolidColorBrush x:Key="ThirdAccent" Color="#DB2777"/>
    
    <Color x:Key="ThirdWhiteColor">#251E2B</Color>
    <Color x:Key="SecondWhiteColor">#3D3045</Color>
    <Color x:Key="PrimaryWhiteColor">#1C1621</Color>
    <Color x:Key="PrimaryAccentColor">#FBCFE8</Color>
    <Color x:Key="SecondAccentColor">#F472B6</Color>
    <Color x:Key="ThirdAccentColor">#DB2777</Color>

</ResourceDictionary>