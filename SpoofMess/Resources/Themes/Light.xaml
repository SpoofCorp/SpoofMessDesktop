<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <SolidColorBrush x:Key="ShadowColor" Color="#111111"/>
    
    <SolidColorBrush x:Key="DefaultTextColor" Color="Gray"/>
    <SolidColorBrush x:Key="ActiveTextColor" Color="#2D3436"/>

    <SolidColorBrush x:Key="PrimaryBlack" Color="#1A202C"/>
    <SolidColorBrush x:Key="SecondBlack" Color="#718096"/>

    <SolidColorBrush x:Key="Six" Color="#64748B"/>
    <SolidColorBrush x:Key="Five" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Four" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Third" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Second" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="Primary" Color="#FFFFFF"/>
    
    <SolidColorBrush x:Key="PrimaryAccent" Color="#70B2FF"/>
    <SolidColorBrush x:Key="SecondAccent" Color="#4D9EFF"/>
    <SolidColorBrush x:Key="ThirdAccent" Color="#338BFF"/>

    <Color x:Key="ThirdWhiteColor">#E2E8F0</Color>
    <Color x:Key="SecondWhiteColor">#F5F7FA</Color>
    <Color x:Key="PrimaryWhiteColor">#FFFFFF</Color>

    <Color x:Key="PrimaryAccentColor">#70B2FF</Color>
    <Color x:Key="SecondAccentColor">#4D9EFF</Color>
    <Color x:Key="ThirdAccentColor">#338BFF</Color>
</ResourceDictionary>