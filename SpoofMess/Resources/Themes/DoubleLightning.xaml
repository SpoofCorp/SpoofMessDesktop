<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="ShadowColor" Color="#0B0D10"/>

    <SolidColorBrush x:Key="DefaultTextColor" Color="#93A2B5"/>
    <SolidColorBrush x:Key="ActiveTextColor" Color="#F2F5F9"/>

    <SolidColorBrush x:Key="PrimaryBlack" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondBlack" Color="#FDF4FA"/>

    <SolidColorBrush x:Key="SixWhite" Color="#E0F2FE"/>
    <SolidColorBrush x:Key="FiveWhite" Color="#D6BCFA"/>
    <SolidColorBrush x:Key="FourWhite" Color="#5C6E85"/>
    <SolidColorBrush x:Key="ThirdWhite" Color="#1E232A"/>
    <SolidColorBrush x:Key="SecondWhite" Color="#2F3745"/>
    <SolidColorBrush x:Key="PrimaryWhite" Color="#14181F"/>

    <SolidColorBrush x:Key="PrimaryAccent" Color="#93C5FD"/>
    <SolidColorBrush x:Key="SecondAccent" Color="#60A5FA"/>
    <SolidColorBrush x:Key="ThirdAccent" Color="#2563EB"/>

    <Color x:Key="ThirdWhiteColor">#1E232A</Color>
    <Color x:Key="SecondWhiteColor">#2F3745</Color>
    <Color x:Key="PrimaryWhiteColor">#14181F</Color>
    <Color x:Key="PrimaryAccentColor">#93C5FD</Color>
    <Color x:Key="SecondAccentColor">#60A5FA</Color>
    <Color x:Key="ThirdAccentColor">#2563EB</Color>
</ResourceDictionary>