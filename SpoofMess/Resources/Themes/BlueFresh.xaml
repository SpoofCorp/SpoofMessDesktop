<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="ShadowColor" Color="#111111"/>

    <SolidColorBrush x:Key="DefaultTextColor" Color="#5A6A85"/>
    <SolidColorBrush x:Key="ActiveTextColor" Color="#1E293B"/>
    <SolidColorBrush x:Key="PrimaryBlack" Color="#0F172A"/>

    <SolidColorBrush x:Key="SecondBlack" Color="#334155"/>
    <SolidColorBrush x:Key="SixWhite" Color="#2563EB"/>
    <SolidColorBrush x:Key="FiveWhite" Color="#3B82F6"/>
